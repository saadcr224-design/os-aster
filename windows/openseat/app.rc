    AUTOCHECKBOX "Sound", 253, 282, 106, 44, 12
    LTEXT "Workplace 7", 269, 10, 125, 60, 10
    AUTOCHECKBOX "Switched on", 260, 74, 124, 62, 12
    AUTOCHECKBOX "Copy and paste", 261, 140, 124, 70, 12
    AUTOCHECKBOX "Shared folder", 262, 214, 124, 64, 12
    AUTOCHECKBOX "Sound", 263, 282, 124, 44, 12
    LTEXT "Workplace 8", 279, 10, 143, 60, 10
    AUTOCHECKBOX "Switched on", 270, 74, 142, 62, 12
    AUTOCHECKBOX "Copy and paste", 271, 140, 142, 70, 12
    AUTOCHECKBOX "Shared folder", 272, 214, 142, 64, 12
