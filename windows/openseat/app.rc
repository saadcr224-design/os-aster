    AUTOCHECKBOX "Shared folder", 292, 214, 178, 64, 12
    AUTOCHECKBOX "Sound", 293, 282, 178, 44, 12
    LTEXT "", IDC_SHARE_INFO, 10, 202, 320, 92
    DEFPUSHBUTTON "OK", IDOK, 224, 300, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 280, 300, 50, 14
END

IDD_NAME DIALOGEX 0, 0, 260, 84
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save setup"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "", IDC_NAME_PROMPT, 10, 8, 240, 20
    EDITTEXT IDC_NAME_EDIT, 10, 32, 240, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 144, 62, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 62, 50, 14
END

IDD_SETUPS DIALOGEX 0, 0, 470, 270
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Saved setups"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Every saved setup is kept separately. Choose one to see what it holds. Open and start uses it and starts its workplaces.", -1, 10, 8, 450, 12
    CONTROL "", IDC_SETUP_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 24, 250, 216
    LTEXT "No saved setups yet. Press Save setup in the main window.", IDC_SETUP_EMPTY, 20, 60, 230, 24
    EDITTEXT IDC_SETUP_DETAILS, 268, 24, 192, 216, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON "Open and start", IDC_SETUP_START, 10, 248, 70, 14
    PUSHBUTTON "Open", IDC_SETUP_OPEN, 86, 248, 50, 14
    PUSHBUTTON "Rename", IDC_SETUP_RENAME, 142, 248, 50, 14
    PUSHBUTTON "Delete", IDC_SETUP_DELETE, 198, 248, 50, 14
    PUSHBUTTON "Close", IDCANCEL, 404, 248, 56, 14
END

IDD_WORKPLACE DIALOGEX 0, 0, 260, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Workplace settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Name:", -1, 10, 11, 40, 10
    EDITTEXT IDC_WP_NAME, 54, 9, 196, 14, ES_AUTOHSCROLL
    LTEXT "", IDC_WP_INFO, 10, 30, 240, 30
    LTEXT "Allowed:", IDC_WP_SHARE_LABEL, 10, 66, 60, 10
    AUTOCHECKBOX "Switched on", IDC_WP_ON, 20, 80, 110, 12
    AUTOCHECKBOX "Copy and paste with Workplace 1", IDC_WP_CLIP, 130, 80, 125, 12
    AUTOCHECKBOX "Shared folder", IDC_WP_FOLDER, 20, 96, 110, 12
    AUTOCHECKBOX "Sound", IDC_WP_SOUND, 130, 96, 110, 12
    DEFPUSHBUTTON "OK", IDOK, 144, 134, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 134, 50, 14
END
