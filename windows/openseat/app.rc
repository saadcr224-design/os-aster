#include <windows.h>
#include "resource.h"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OpenSeat workplace setup"
      VALUE "ProductName", "OpenSeat"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductVersion", "0.2.0"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "OpenSeat.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_ACCOUNT DIALOGEX 0, 0, 268, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Windows account for this workplace"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "", IDC_ACC_INFO, 10, 8, 248, 26
    LTEXT "Account name:", -1, 10, 44, 82, 10
    EDITTEXT IDC_ACC_NAME, 96, 42, 162, 13, ES_AUTOHSCROLL
    LTEXT "Password:", -1, 10, 64, 82, 10
    EDITTEXT IDC_ACC_PASS, 96, 62, 162, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Password again:", -1, 10, 84, 82, 10
    EDITTEXT IDC_ACC_PASS2, 96, 82, 162, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "If this account does not exist yet, OpenSeat creates it when you press Start. The password is kept in Windows Credential Manager.", -1, 10, 102, 248, 20
    DEFPUSHBUTTON "OK", IDOK, 152, 134, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 208, 134, 50, 14
END
