#include <windows.h>
#include "resource.h"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "OpenSeat workplace setup"
      VALUE "ProductName", "OpenSeat"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductVersion", "0.2.0"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "OpenSeat.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_SHARING DIALOGEX 0, 0, 340, 214
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connections and sharing"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "Choose what each workplace is allowed to do. Anything not ticked stays private.", -1, 10, 8, 320, 18
    LTEXT "Workplace 2", 219, 10, 35, 60, 10
    AUTOCHECKBOX "Switched on", 210, 74, 34, 62, 12
    AUTOCHECKBOX "Copy and paste", 211, 140, 34, 70, 12
    AUTOCHECKBOX "Shared folder", 212, 214, 34, 64, 12
    AUTOCHECKBOX "Sound", 213, 282, 34, 44, 12
    LTEXT "Workplace 3", 229, 10, 53, 60, 10
    AUTOCHECKBOX "Switched on", 220, 74, 52, 62, 12
    AUTOCHECKBOX "Copy and paste", 221, 140, 52, 70, 12
    AUTOCHECKBOX "Shared folder", 222, 214, 52, 64, 12
    AUTOCHECKBOX "Sound", 223, 282, 52, 44, 12
    LTEXT "Workplace 4", 239, 10, 71, 60, 10
    AUTOCHECKBOX "Switched on", 230, 74, 70, 62, 12
    AUTOCHECKBOX "Copy and paste", 231, 140, 70, 70, 12
    AUTOCHECKBOX "Shared folder", 232, 214, 70, 64, 12
    AUTOCHECKBOX "Sound", 233, 282, 70, 44, 12
    LTEXT "", IDC_SHARE_INFO, 10, 94, 320, 92
    DEFPUSHBUTTON "OK", IDOK, 224, 192, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 280, 192, 50, 14
END
