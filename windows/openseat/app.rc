#include <windows.h>
#include "resource.h"
#include "version.h"
1 ICON "brand/vision.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VISION_VERSION_RC
PRODUCTVERSION VISION_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "VISION - several workplaces on one PC"
      VALUE "ProductName", "VISION"
      VALUE "FileVersion", VISION_VERSION
      VALUE "ProductVersion", VISION_VERSION
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "VISION.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_SHARING DIALOGEX 0, 0, 340, 322
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connections and sharing"
FONT 9, "Segoe UI", 400, 0, 1
